    },
    {
      "name": "tone",
      "label": "Tone",
      "columns": [
        { "label": "Name", "field": "name", "class": "name" }
      ],
      "grid-template-columns": "0.25fr 6fr 0.25fr",
      "group-tags": ["tone"],
      "verses": [
        {
          "name": "Calm",
          "description": "Each target recovers (key recovery) equal to (10 + twice your current Willpower die size). This amount increases by 10 if you are level 20 or higher, or by 20 if you are level 40 or higher.\nIf this tone causes MP recovery, it has no effect on the character who sings it.",
          "tags": ["calm", "recovery", "hp", "mp", "willpower"]
        },
        {
          "name": "Energetic",
          "description": "Until the start of your next turn, when a target succeeds on a Check that includes (key Attribute) and that Check allows them to advance or turn back a Clock, they may fill or erase an additional section of that Clock.",
          "tags": ["energetic", "clock", "check"]
        },
        {
          "name": "Frantic",
          "description": "You deal an amount of (key type) damage equal to twice your current Willpower die to each target. This tone deals 5 extra damage if you are level 20 or higher, or 10 extra damage if you are level 40 or higher.",
          "tags": ["frantic", "damage", "willpower"]
        },
        {
          "name": "Haunting",
          "description": "Each target suffers (key status effect). Each target also loses Resistance to (key type) damage (if they have it) until the start of your next turn, and cannot gain Resistance to that damage type.",
          "tags": ["haunting", "status", "resistance"]
        },
        {
          "name": "Lively",
          "description": "Each target treats their (key Attribute) as being one die size higher (up to a maximum of d12) until the start of your next turn.",
          "tags": ["lively", "attribute", "buff"]
        },
        {
          "name": "Menacing",
          "description": "The first time each target suffers damage before the start of your next turn, that damage becomes (key type). This can trigger once for each target of the verse, separately.",
          "tags": ["menacing", "damage", "type-change"]
        },
        {
          "name": "Solemn",
          "description": "Each target recovers from (key status effect). Each target also gains Resistance to (key type) damage until the start of your next turn.",
          "tags": ["solemn", "cleanse", "resistance"]
        }
      ]
    }
  ]
}