{
  "schema": {
    "key": "verses",
    "title": "Verses",
    "universal-tags": ["chanter", "verse"]
  },
  "groups": [
    {
      "name": "volume",
      "label": "Volume",
      "columns": [
        { "label": "Name", "field": "name", "class": "name" },
        { "label": "MP", "field": "mp", "class": "mp" },
        { "label": "Targets", "field": "targets", "class": "targets" }
      ],
      "grid-template-columns": "0.25fr 1.25fr 1fr 3.75fr 0.25fr",
      "group-tags": ["volume"],
      "verses": [
        {
          "name": "Low",
          "mp": "10",
          "targets": "Yourself or another creature you can see who can hear you.",
          "description": "",
          "tags": ["low", "single-target"]
        },
        {
          "name": "Medium",
          "mp": "20",
          "targets": "Every ally who can hear you.",
          "description": "",
          "tags": ["medium", "area-ally"]
        },
        {
          "name": "High",
          "mp": "30",
          "targets": "Every enemy who can hear you.",
          "description": "",
          "tags": ["high", "area-enemy"]
        }
      ]
    },
    {
      "name": "key",
      "label": "Key",
      "columns": [
        { "label": "Name", "field": "name", "class": "name" },
        { "label": "Type", "field": "type", "class": "type" },
        { "label": "Status Effect", "field": "status_effect", "class": "status-effect" },
        { "label": "Attribute", "field": "attribute", "class": "attribute" },
        { "label": "Recovery", "field": "recovery", "class": "recovery" }
      ],
      "grid-template-columns": "0.25fr 1.25fr 1fr 1.25fr 1.25fr 1.25fr 0.25fr",
      "group-tags": ["key"],
      "verses": [
        {
          "name": "Flame",
          "type": "fire",
          "status_effect": "shaken",
          "attribute": "Might",
          "recovery": "Hit Points",
          "description": "",
          "tags": ["flame", "fire", "shaken", "might", "hp"]
        },
        {
          "name": "Frost",
          "type": "ice",
          "status_effect": "weak",
          "attribute": "Willpower",
          "recovery": "Mind Points",
          "description": "",
          "tags": ["frost", "ice", "weak", "willpower", "mp"]
        },
        {
          "name": "Iron",
          "type": "physical",
          "status_effect": "slow",
          "attribute": "Willpower",
          "recovery": "Mind Points",
          "description": "",
          "tags": ["iron", "physical", "slow", "willpower", "mp"]
        },
        {
          "name": "Radiance",
          "type": "light",
          "status_effect": "dazed",
          "attribute": "Insight",
          "recovery": "Hit Points",
          "description": "",
          "tags": ["radiance", "light", "dazed", "insight", "hp"]
        },
        {
          "name": "Shadow",
          "type": "dark",
          "status_effect": "weak",
          "attribute": "Dexterity",
          "recovery": "Mind Points",
          "description": "",
          "tags": ["shadow", "dark", "weak", "dexterity", "mp"]
        },
        {
          "name": "Stone",
          "type": "earth",
          "status_effect": "dazed",
          "attribute": "Might",
          "recovery": "Hit Points",
          "description": "",
          "tags": ["stone", "earth", "dazed", "might", "hp"]
        },
        {
          "name": "Thunder",
          "type": "bolt",
          "status_effect": "shaken",
          "attribute": "Dexterity",
          "recovery": "Hit Points",
          "description": "",
          "tags": ["thunder", "bolt", "shaken", "dexterity", "hp"]
        },
        {
          "name": "Wind",
          "type": "air",
          "status_effect": "slow",
          "attribute": "Insight",
          "recovery": "Mind Points",
          "description": "",
